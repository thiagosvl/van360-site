---
import Layout from "../layouts/Layout.astro";
import HeaderLP from "../components/HeaderLP.astro";
import Footer from "../components/Footer.astro";
import VideoCommerce from "../components/VideoCommerce.astro";
import { blogApi } from "../utils/api";

import HeroSection from "../components/landing/HeroSection.astro";
import SocialProofBar from "../components/landing/SocialProofBar.astro";
import FeaturesSection from "../components/landing/FeaturesSection.astro";
import ComparisonSection from "../components/landing/ComparisonSection.astro";
import TestimonialsSection from "../components/landing/TestimonialsSection.astro";
import HowItWorksSection from "../components/landing/HowItWorksSection.astro";
import PricingSection from "../components/landing/PricingSection.astro";
import FaqSection from "../components/landing/FaqSection.astro";
import FinalCtaSection from "../components/landing/FinalCtaSection.astro";
import FloatingWhatsApp from "../components/landing/FloatingWhatsApp.astro";
import StickyMobileCta from "../components/landing/StickyMobileCta.astro";

import {
  heroSlides,
  corePlanFeatures,
  additionalPlanFeatures,
  features,
  howItWorks,
  getFaqItems,
  SUPABASE_VIDEOS_BASE_URL,
  videoCommerceStories,
} from "../data/landingData";

const plansData = await blogApi.getPublicPlans();

const formatCurrency = (val: number) => {
  return new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
  }).format(val);
};

const isPromoActive = plansData.isPromotionActive;
const monthlyPlan = plansData.plans.find((p) => p.identificador === "MONTHLY");
const yearlyPlan = plansData.plans.find((p) => p.identificador === "YEARLY");

if (!monthlyPlan) {
  throw new Error(
    "[Astro Build] Falha de integridade: Plano mensal ('MONTHLY') não foi retornado pelo banco de dados.",
  );
}
if (!yearlyPlan) {
  throw new Error(
    "[Astro Build] Falha de integridade: Plano anual ('YEARLY') não foi retornado pelo banco de dados.",
  );
}

const monthlyNormalVal = monthlyPlan.valor;
const originalVal = isPromoActive
  ? (monthlyPlan.valor_promocional ?? monthlyPlan.valor)
  : monthlyPlan.valor;

const yearlyTotalVal = isPromoActive
  ? (yearlyPlan.valor_promocional ?? yearlyPlan.valor)
  : yearlyPlan.valor;

const originalFormatted = formatCurrency(originalVal).replace("R$", "").trim();
const monthlyNormalFormatted = formatCurrency(monthlyNormalVal)
  .replace("R$", "")
  .trim();
const yearlyTotalFormatted = formatCurrency(yearlyTotalVal)
  .replace("R$", "")
  .trim();
const annualSavingsVal = Math.max(0, originalVal * 12 - yearlyTotalVal);
const annualSavingsFormatted = formatCurrency(annualSavingsVal)
  .replace("R$", "")
  .trim();
const annualMonthlyEquivFormatted = formatCurrency(yearlyTotalVal / 12)
  .replace("R$", "")
  .trim();
const regularAnnualTotalFormatted = formatCurrency(originalVal * 12)
  .replace("R$", "")
  .trim();

const faqItems = getFaqItems(originalFormatted);

const siteUrl =
  import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || Astro.url.origin;

const schemaJson = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Van360",
    description:
      "Organize alunos, parcelas, contratos e recibos. Automatize a cobrança de parcelas pelo WhatsApp.",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Android, Web",
    url: siteUrl,
    offers: {
      "@type": "Offer",
      price: originalVal.toFixed(2),
      priceCurrency: "BRL",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
]);
---

<Layout
  title="Van360 — App para Van Escolar e Gestão de Alunos"
  description="Gerencie alunos, parcelas, contratos e recibos. Automatize a cobrança de parcelas pelo WhatsApp e organize sua van escolar. Teste grátis por 15 dias."
>
  <script type="application/ld+json" slot="head" set:html={schemaJson} />
  <div
    class="min-h-screen bg-white text-[#1a1a1a] font-['Inter',sans-serif] overflow-x-hidden scroll-smooth selection:bg-amber-200"
  >
    <HeaderLP />
    <main>
      <style is:global>
        .lp-reveal {
          opacity: 0;
          transform: translateY(24px);
          transition:
            opacity 0.6s ease,
            transform 0.6s ease;
        }
        .lp-visible {
          opacity: 1;
          transform: translateY(0);
        }
        @keyframes lp-countUp {
          from {
            opacity: 0;
            transform: translateY(12px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
        @keyframes lp-cta-glow {
          0%,
          100% {
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
          }
          50% {
            box-shadow: 0 4px 20px rgba(245, 158, 11, 0.5);
          }
        }
        .lp-cta-glow {
          animation: lp-cta-glow 2.5s ease-in-out infinite;
        }
        .hide-scrollbar::-webkit-scrollbar {
          display: none;
        }
        .hide-scrollbar {
          -ms-overflow-style: none;
          scrollbar-width: none;
        }
        @media (min-width: 768px) {
          .hero-phone {
            transition: transform 0.3s ease;
          }
          .hero-phone:hover {
            transform: translateY(-4px);
          }
          .feature-phone {
            transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
          }
          .feature-phone:hover {
            transform: translateY(-12px) scale(1.03);
          }
        }
      </style>

      <div class="h-14 md:h-16"></div>

      <HeroSection heroSlides={heroSlides} />
      <TestimonialsSection />
      <SocialProofBar />
      <FeaturesSection features={features} />
      <ComparisonSection />
      <HowItWorksSection howItWorks={howItWorks} />
      <PricingSection
        isPromoActive={isPromoActive}
        originalVal={originalVal}
        monthlyNormalVal={monthlyNormalVal}
        monthlyNormalFormatted={monthlyNormalFormatted}
        originalFormatted={originalFormatted}
        yearlyTotalFormatted={yearlyTotalFormatted}
        annualSavingsVal={annualSavingsVal}
        annualSavingsFormatted={annualSavingsFormatted}
        regularAnnualTotalFormatted={regularAnnualTotalFormatted}
        annualMonthlyEquivFormatted={annualMonthlyEquivFormatted}
        corePlanFeatures={corePlanFeatures}
        additionalPlanFeatures={additionalPlanFeatures}
      />
      <FaqSection faqItems={faqItems} />
      <FinalCtaSection />
    </main>

    <Footer />

    <FloatingWhatsApp />
    <StickyMobileCta />

    <VideoCommerce
      previewUrl={`${SUPABASE_VIDEOS_BASE_URL}/lp-videocommerce-parcelas.mp4`}
      videosData={videoCommerceStories}
      tooltipText="Veja como funciona"
      positionClasses="fixed z-40 left-4 sm:left-6 bottom-20 sm:bottom-8"
      ctaText="Começar 15 dias grátis"
      ctaLink="/cadastro"
    />
  </div>
</Layout>

<script is:inline>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("lp-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05, rootMargin: "0px 0px -40px 0px" },
  );

  document.querySelectorAll(".lp-reveal").forEach((el) => {
    observer.observe(el);
  });
</script>
