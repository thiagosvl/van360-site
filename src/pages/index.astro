          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
        ></path>
      </svg>
    </a>

    {
      /*
    <VideoCommerce
      previewUrl="https://res.cloudinary.com/demo/video/upload/dog.mp4"
      videoUrls={[
        "https://res.cloudinary.com/demo/video/upload/dog.mp4",
        "https://res.cloudinary.com/demo/video/upload/elephants.mp4",
        "https://www.w3schools.com/html/mov_bbb.mp4"
      ]}
      positionClasses="fixed z-40 left-4 sm:left-6 top-[65%] sm:top-auto sm:bottom-10"
    />
    */
    }
  </div>
</Layout>

<script is:inline>
  // ── Scroll Reveal Vanilla implementation ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("lp-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05, rootMargin: "0px 0px -40px 0px" },
  );

  document.querySelectorAll(".lp-reveal").forEach((el) => {
    observer.observe(el);
  });

  // ── FAQ Accordion Vanilla implementation ──
  document.querySelectorAll(".faq-button").forEach((button) => {
    button.addEventListener("click", () => {
      const content = button.nextElementSibling;
      const icon = button.querySelector(".faq-icon");
      const isOpen = button.getAttribute("aria-expanded") === "true";

      // Close all other FAQs first to be clean
      document.querySelectorAll(".faq-button").forEach((otherBtn) => {
        if (
          otherBtn !== button &&
          otherBtn.getAttribute("aria-expanded") === "true"
        ) {
          otherBtn.setAttribute("aria-expanded", "false");
          otherBtn.nextElementSibling.style.maxHeight = "0px";
          otherBtn.querySelector(".faq-icon").classList.remove("rotate-180");
        }
      });

      button.setAttribute("aria-expanded", !isOpen ? "true" : "false");
      if (!isOpen) {
        content.style.maxHeight = content.scrollHeight + "px";
        icon.classList.add("rotate-180");
      } else {
        content.style.maxHeight = "0px";
        icon.classList.remove("rotate-180");
      }
    });
  });

  // ── Platform tailored UI implementation ──
  const isIOS = /iPhone|iPad/i.test(navigator.userAgent);
  const isMobile = window.matchMedia("(max-width: 768px)").matches || isIOS;

  if (isMobile) {
    if (isIOS) {
      document.getElementById("badge-ios-mobile")?.classList.remove("hidden");
      document.getElementById("badge-ios-cta")?.classList.remove("hidden");
    } else {
      document
        .getElementById("badge-android-mobile")
        ?.classList.remove("hidden");
      document.getElementById("badge-android-cta")?.classList.remove("hidden");
    }
  } else {
    // Desktop: show Android badge on final CTA as fallback
    document.getElementById("badge-android-cta")?.classList.remove("hidden");
  }

  // ── Cookie Consent Banner Vanilla implementation ──
  const COOKIE_NAME = "van360_cookie_consent";
  const banner = document.getElementById("cookie-banner");
  const waBtn = document.getElementById("floating-whatsapp");

  const updateBodyPadding = () => {
    if (!banner || banner.classList.contains("hidden")) return;
    const padding = window.innerWidth < 640 ? "68px" : "56px";
    document.body.style.paddingBottom = padding;
    if (waBtn) {
      waBtn.style.bottom = window.innerWidth < 640 ? "84px" : "72px";
    }
  };

  const hideBanner = () => {
    if (banner) banner.classList.add("hidden");
    document.body.style.paddingBottom = "";
    if (waBtn) waBtn.style.bottom = "20px";
  };

  const getCookie = (name) => {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(";").shift();
    return null;
  };

  const setCookie = (name, value, days) => {
    const d = new Date();
    d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
    document.cookie = `${name}=${value};expires=${d.toUTCString()};path=/`;
  };

  // Check consent
  if (!getCookie(COOKIE_NAME)) {
    if (banner) banner.classList.remove("hidden");
    updateBodyPadding();
    window.addEventListener("resize", updateBodyPadding);
  }

  document
    .getElementById("cookie-btn-accept")
    ?.addEventListener("click", () => {
      setCookie(COOKIE_NAME, "accepted", 365);
      hideBanner();
    });

  document
    .getElementById("cookie-btn-reject")
    ?.addEventListener("click", () => {
      setCookie(COOKIE_NAME, "rejected", 365);
      hideBanner();
    });

  document
    .getElementById("cookie-btn-customize")
    ?.addEventListener("click", () => {
      setCookie(COOKIE_NAME, "accepted", 365);
      hideBanner();
    });

  // ── Pricing Tabs Switcher Vanilla implementation ──
  const tabMonthly = document.getElementById("lp-tab-monthly");
  const tabYearly = document.getElementById("lp-tab-yearly");
  const cardMonthly = document.getElementById("lp-card-monthly");
  const cardYearly = document.getElementById("lp-card-yearly");

  function setPricingPeriod(period) {
    if (period === "monthly") {
      tabMonthly?.classList.add("bg-white", "text-[#1a3a5c]", "shadow-xs");
      tabMonthly?.classList.remove("text-slate-500");

      tabYearly?.classList.remove("bg-white", "text-[#1a3a5c]", "shadow-xs");
      tabYearly?.classList.add("text-slate-500");

      cardMonthly?.classList.remove("hidden");
      cardYearly?.classList.add("hidden");
    } else {
      tabYearly?.classList.add("bg-white", "text-[#1a3a5c]", "shadow-xs");
      tabYearly?.classList.remove("text-slate-500");

      tabMonthly?.classList.remove("bg-white", "text-[#1a3a5c]", "shadow-xs");
      tabMonthly?.classList.add("text-slate-500");

      cardYearly?.classList.remove("hidden");
      cardMonthly?.classList.add("hidden");
    }
  }

  tabMonthly?.addEventListener("click", () => setPricingPeriod("monthly"));
  tabYearly?.addEventListener("click", () => setPricingPeriod("yearly"));

  // Helper para toggles de features em ambos os cards
  function setupFeaturesToggle(btnId, containerId, textId, iconId) {
    const btn = document.getElementById(btnId);
    const container = document.getElementById(containerId);
    const text = document.getElementById(textId);
    const icon = document.getElementById(iconId);

    if (btn && container) {
      btn.addEventListener("click", () => {
        const isHidden = container.classList.contains("hidden");
        if (isHidden) {
          container.classList.remove("hidden");
          btn.setAttribute("aria-expanded", "true");
          if (text) text.textContent = "Ocultar";
          if (icon) icon.classList.add("rotate-180");
        } else {
          container.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
          if (text) text.textContent = "Ver mais benefícios inclusos";
          if (icon) icon.classList.remove("rotate-180");
        }
      });
    }
  }

  setupFeaturesToggle(
    "toggle-monthly-features-btn",
    "additional-monthly-features",
    "toggle-monthly-features-text",
    "toggle-monthly-features-icon",
  );
  setupFeaturesToggle(
    "toggle-yearly-features-btn",
    "additional-yearly-features",
    "toggle-yearly-features-text",
    "toggle-yearly-features-icon",
  );

  // ── Testimonials Carousel Vanilla implementation ──
  const lpTestimonials = [
    {
      name: "Tio Marcos",
      role: "Transporte Escolar na Zona Sul de SP • 67 alunos",
      quote:
        "Desde o mês passado já reduzi a inadimplência de 3 pais. Foram quase 700 reais que talvez eu nem fosse receber, mas o app cobrou os pais sozinho.",
      rating: "5/5",
    },
    {
      name: "Tia Cláudia",
      role: "Transporte Escolar em Belo Horizonte/MG • 54 alunos",
      quote:
        "Os pais assinam o contrato direto pelo link no celular. Agora não preciso mais imprimir e levar o contrato de porta em porta dos pais.",
      rating: "5/5",
    },
    {
      name: "Tio Roberto",
      role: "Transporte Escolar em Curitiba/PR • 112 alunos",
      quote:
        "Na saída da escola, poder fazer a chamada pelo app é muito mais prático do que no papel. Em um minuto já sei certinho quem embarcou.",
      rating: "5/5",
    },
    {
      name: "Tia Valéria",
      role: "Transporte Escolar na Zona Norte do RJ • 51 alunos",
      quote:
        "Deixei minhas planilhas de lado de vez. O app me mostra na hora quem já pagou o mês e quem está pendente com total clareza.",
      rating: "5/5",
    },
    {
      name: "Tio Anderson",
      role: "Transporte Escolar em Brasília/DF • 63 alunos",
      quote:
        "O suporte é rápido de verdade e o melhor é não precisar mais ficar cobrando os pais. O app avisa todo mundo certinho no WhatsApp.",
      rating: "5/5",
    },
  ];

  let currentLpTestimonialIdx = 0;
  const lpQuoteEl = document.getElementById("lp-testimonial-quote");
  const lpNameEl = document.getElementById("lp-testimonial-name");
  const lpRoleEl = document.getElementById("lp-testimonial-role");
  const lpRatingEl = document.getElementById("lp-testimonial-rating");
  const lpDotsContainer = document.getElementById("lp-testimonial-dots");
  const lpPrevBtn = document.getElementById("lp-prev-testimonial-btn");
  const lpNextBtn = document.getElementById("lp-next-testimonial-btn");
  const lpCardEl = document.getElementById("testimonials-card");
  const lpContentEl = document.getElementById("lp-testimonial-content");

  function updateStars(rating) {
    const numStars = parseInt(rating.split("/")[0]) || 5;
    const stars = document.querySelectorAll("#lp-testimonial-stars svg");
    stars.forEach((star, idx) => {
      if (idx < numStars) {
        star.setAttribute("class", "w-4 h-4 fill-amber-400 text-amber-400");
      } else {
        star.setAttribute("class", "w-4 h-4 fill-slate-200 text-slate-300");
      }
    });
  }

  function updateLpTestimonial(index, direction = "next") {
    if (index < 0) index = lpTestimonials.length - 1;
    if (index >= lpTestimonials.length) index = 0;
    currentLpTestimonialIdx = index;

    const t = lpTestimonials[currentLpTestimonialIdx];

    if (lpContentEl) {
      lpContentEl.style.transition =
        "opacity 0.15s ease-out, transform 0.15s ease-out";
      lpContentEl.style.opacity = "0";
      lpContentEl.style.transform =
        direction === "next" ? "translateX(-16px)" : "translateX(16px)";

      setTimeout(() => {
        if (lpQuoteEl) lpQuoteEl.textContent = `"${t.quote}"`;
        if (lpNameEl) lpNameEl.textContent = t.name;
        if (lpRoleEl) lpRoleEl.textContent = t.role;
        if (lpRatingEl) lpRatingEl.textContent = t.rating;
        updateStars(t.rating);

        lpContentEl.style.transition = "none";
        lpContentEl.style.transform =
          direction === "next" ? "translateX(16px)" : "translateX(-16px)";
        void lpContentEl.offsetHeight;

        lpContentEl.style.transition =
          "opacity 0.25s ease-out, transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1)";
        lpContentEl.style.opacity = "1";
        lpContentEl.style.transform = "translateX(0px)";
      }, 150);
    } else {
      if (lpQuoteEl) lpQuoteEl.textContent = `"${t.quote}"`;
      if (lpNameEl) lpNameEl.textContent = t.name;
      if (lpRoleEl) lpRoleEl.textContent = t.role;
      if (lpRatingEl) lpRatingEl.textContent = t.rating;
      updateStars(t.rating);
    }

    if (lpDotsContainer) {
      lpDotsContainer.innerHTML = "";
      lpTestimonials.forEach((_, i) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = `h-1.5 rounded-full transition-all duration-300 cursor-pointer ${
          currentLpTestimonialIdx === i
            ? "w-5 bg-[#002444]"
            : "w-1.5 bg-slate-200"
        }`;
        dot.setAttribute("aria-label", `Ir para depoimento ${i + 1}`);
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          updateLpTestimonial(i, i > currentLpTestimonialIdx ? "next" : "prev");
        });
        lpDotsContainer.appendChild(dot);
      });
    }
  }

  if (lpQuoteEl) {
    updateLpTestimonial(0, "next");
  }

  if (lpPrevBtn) {
    lpPrevBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      updateLpTestimonial(currentLpTestimonialIdx - 1, "prev");
    });
  }

  if (lpNextBtn) {
    lpNextBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      updateLpTestimonial(currentLpTestimonialIdx + 1, "next");
    });
  }

  let lpTouchStartX = null;
  let lpTouchDeltaX = 0;
  const lpMinSwipeDistance = 35;

  if (lpCardEl && lpContentEl) {
    lpCardEl.addEventListener(
      "touchstart",
      (e) => {
        lpTouchStartX = e.changedTouches[0].clientX;
        lpTouchDeltaX = 0;
      },
      { passive: true },
    );

    lpCardEl.addEventListener(
      "touchmove",
      (e) => {
        if (lpTouchStartX === null) return;
        const currentX = e.changedTouches[0].clientX;
        const diff = currentX - lpTouchStartX;
        lpTouchDeltaX = Math.sign(diff) * Math.min(65, Math.abs(diff) * 0.6);
        lpContentEl.style.transition = "none";
        lpContentEl.style.transform = `translateX(${lpTouchDeltaX}px)`;
      },
      { passive: true },
    );

    lpCardEl.addEventListener(
      "touchend",
      () => {
        if (lpTouchStartX !== null) {
          if (lpTouchDeltaX < -lpMinSwipeDistance) {
            updateLpTestimonial(currentLpTestimonialIdx + 1, "next");
          } else if (lpTouchDeltaX > lpMinSwipeDistance) {
            updateLpTestimonial(currentLpTestimonialIdx - 1, "prev");
          } else {
            lpContentEl.style.transition =
              "transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1)";
            lpContentEl.style.transform = "translateX(0px)";
          }
        }
        lpTouchStartX = null;
        lpTouchDeltaX = 0;
      },
      { passive: true },
    );
  }
</script>
