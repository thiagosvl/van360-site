---
import Layout from "../layouts/Layout.astro";
import { LINKS } from "../constants/links";
import HeaderLP from "../components/HeaderLP.astro";
import Footer from "../components/Footer.astro";
import { blogApi } from "../utils/api";
import VideoCommerce from "../components/VideoCommerce.astro";
import FloatingVideoBubble from "../components/video/FloatingVideoBubble.astro";
import { Image } from "astro:assets";
import {
  Users,
  Clock,
  Smartphone,
  Star,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Smile,
  Check,
  CheckCircle2,
  XCircle,
  ArrowRight,
} from "@lucide/astro";

// Imports de imagens para otimização pelo Astro
import mockup3dHome from "../assets/lp/mockup-3d-home.webp";
import mockup3dMensalidades from "../assets/lp/mockup-3d-mensalidades.webp";
import mockupHome from "../assets/lp/mockup-home.webp";
import mockupMensalidades from "../assets/lp/mockup-mensalidades.webp";
import mockupPassageiros from "../assets/lp/mockup-passageiros.webp";
import mockupCarteirinha from "../assets/lp/mockup-carteirinha.webp";
import mockupRecibo from "../assets/lp/mockup-recibo.webp";
import mockupContrato from "../assets/lp/mockup-contrato.webp";
import mockupGastos from "../assets/lp/mockup-gastos.webp";

// Fetch dynamic plans for pre-rendering
const plansData = await blogApi.getPublicPlans();

// Formatter helper
const formatCurrency = (val: number) => {
  return new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
  }).format(val);
};

const isPromoActive = plansData.isPromotionActive;
const monthlyPlan = plansData.plans.find((p) => p.identificador === "MONTHLY");
const yearlyPlan = plansData.plans.find((p) => p.identificador === "YEARLY");

// Se os planos vitais não existirem no banco, dispara erro para interromper o build imediatamente
if (!monthlyPlan) {
  throw new Error(
    "[Astro Build] Falha de integridade: Plano mensal ('MONTHLY') não foi retornado pelo banco de dados.",
  );
}
if (!yearlyPlan) {
  throw new Error(
    "[Astro Build] Falha de integridade: Plano anual ('YEARLY') não foi retornado pelo banco de dados.",
  );
}

// Lógica de preços direta sem fallbacks codificados no frontend
const monthlyNormalVal = monthlyPlan.valor;
const originalVal = isPromoActive
  ? (monthlyPlan.valor_promocional ?? monthlyPlan.valor)
  : monthlyPlan.valor;

const yearlyTotalVal = isPromoActive
  ? (yearlyPlan.valor_promocional ?? yearlyPlan.valor)
  : yearlyPlan.valor;

const originalFormatted = formatCurrency(originalVal).replace("R$", "").trim();
const monthlyNormalFormatted = formatCurrency(monthlyNormalVal)
  .replace("R$", "")
  .trim();
const yearlyTotalFormatted = formatCurrency(yearlyTotalVal)
  .replace("R$", "")
  .trim();
const annualSavingsVal = Math.max(0, originalVal * 12 - yearlyTotalVal);
const annualSavingsFormatted = formatCurrency(annualSavingsVal)
  .replace("R$", "")
  .trim();
const annualMonthlyEquivFormatted = formatCurrency(yearlyTotalVal / 12)
  .replace("R$", "")
  .trim();
const regularAnnualTotalFormatted = formatCurrency(originalVal * 12)
  .replace("R$", "")
  .trim();

const corePlanFeatures = [
  {
    feature: "Cobrança no WhatsApp",
    benefit: "lembretes com sua chave Pix, sem você ter que cobrar ninguém",
  },
  {
    feature: "Contratos digitais",
    benefit: "assinados no celular com validade jurídica, sem papel",
  },
  {
    feature: "Rotas e chamada",
    benefit: "mapa ao vivo para os pais e chamada na saída da escola",
  },
  {
    feature: "Controle financeiro e gastos",
    benefit: "quem pagou, quem deve e as despesas da sua van",
  },
  {
    feature: "Alunos ilimitados",
    benefit:
      "todos os alunos no app, com dados, escola e responsáveis, sem papel",
  },
];

const additionalPlanFeatures = [
  {
    feature: "Relatórios do seu negócio",
    benefit: "saiba exatamente quanto faturou, gastou e o lucro real do mês",
  },
  {
    feature: "Motoristas e monitores",
    benefit:
      "cadastre sua equipe com acesso às rotas e carteirinhas dos alunos",
  },
  {
