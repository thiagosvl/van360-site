---
import { LINKS } from "../../constants/links";
import { CheckCircle2 } from "@lucide/astro";
import { Image } from "astro:assets";
import type { FeatureItem, ExtraFeatureItem } from "../../data/landingData";

interface Props {
  features: FeatureItem[];
  extraFeatures: ExtraFeatureItem[];
}

const { features, extraFeatures } = Astro.props;
---

<section id="o-que-faz" class="py-14 md:py-20 bg-[#f6f8fb] scroll-mt-20">
  <div class="max-w-[1120px] mx-auto px-5">
    <div class="lp-reveal max-w-[640px] mx-auto text-center mb-9 md:mb-14">
      <h2
        class="text-[clamp(1.7rem,4.2vw,2.5rem)] font-extrabold text-[#1a3a5c] tracking-tight leading-tight mb-3"
      >
        Tudo o que a sua van precisa, num app só
      </h2>
      <p class="text-[1.05rem] sm:text-[1.12rem] text-slate-600 leading-relaxed">
        Feito para a rotina do transporte escolar. Simples de usar no celular.
      </p>
    </div>

    <div class="flex flex-col gap-6 md:gap-10">
      {
        features.map((feat, i) => (
          <article class="lp-reveal bg-white rounded-3xl border border-slate-200/70 shadow-sm overflow-hidden">
            <div class="flex flex-col lg:grid lg:grid-cols-2 lg:items-center gap-2 lg:gap-12 p-4 min-[360px]:p-5 sm:p-8 lg:p-12">
              <div class={`text-left ${i % 2 === 0 ? "lg:order-1" : "lg:order-2"}`}>
                <span class="inline-flex items-center text-[0.85rem] font-extrabold text-[#92400e] bg-[#f59e0b]/15 px-3 py-1 rounded-full mb-3">
                  {feat.tag}
                </span>
                <h3 class="text-[1.45rem] sm:text-[1.7rem] lg:text-[2rem] font-extrabold text-[#1a3a5c] leading-tight mb-4">
                  {feat.headline}
                </h3>
                <ul class="space-y-3">
                  {feat.bullets.map((b) => (
                    <li class="flex items-start gap-3 text-[1.02rem] sm:text-[1.08rem] text-slate-700 leading-snug">
                      <CheckCircle2 class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
                {feat.videoStory && (
                  <button
                    type="button"
                    class="mt-5 inline-flex items-center gap-2.5 text-[0.98rem] font-bold text-[#1a3a5c] py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-amber-50 border border-slate-200 hover:border-amber-300 transition-all cursor-pointer"
                    data-video-story={JSON.stringify(feat.videoStory)}
                  >
                    <span class="w-7 h-7 rounded-full bg-[#1a3a5c] text-white flex items-center justify-center shrink-0">
                      <svg class="w-3 h-3 ml-0.5 fill-current" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </span>
                    Ver funcionando
                  </button>
                )}
              </div>

              <div class={`flex justify-center ${i % 2 === 0 ? "lg:order-2" : "lg:order-1"}`}>
                <div class="relative w-full max-w-[260px] sm:max-w-[280px] lg:max-w-[320px] mt-6 lg:mt-0 feature-phone">
                  <div class="relative max-h-[330px] sm:max-h-[380px] lg:max-h-none overflow-hidden">
                  <Image
                    src={feat.mockup}
                    alt={feat.alt}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 320px, 280px"
                    class="w-full h-auto drop-shadow-xl"
                  />
                  <div class="lg:hidden absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white to-transparent pointer-events-none" />
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- E tem mais -->
    <div class="lp-reveal mt-12 md:mt-16">
      <h3 class="text-center text-[1.35rem] sm:text-[1.6rem] font-extrabold text-[#1a3a5c] mb-6">
        E tem mais
      </h3>
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 md:gap-4">
        {
          extraFeatures.map((x) => (
            <li class="flex flex-col sm:flex-row items-start gap-2 sm:gap-3 bg-white rounded-2xl border border-slate-200/70 p-3 sm:p-4">
              <span class="text-[1.5rem] leading-none shrink-0" aria-hidden="true">{x.icon}</span>
              <span>
                <span class="block text-[0.95rem] sm:text-[1.02rem] font-bold text-[#1a3a5c] leading-tight">{x.title}</span>
                <span class="block text-[0.85rem] sm:text-[0.95rem] text-slate-600 mt-1 leading-snug">{x.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lp-reveal text-center mt-10">
      <a
        href={LINKS.APP_REGISTER_URL}
        class="inline-flex items-center justify-center bg-[#f59e0b] hover:bg-[#d97706] text-[#1a1a1a] font-black text-[1.05rem] px-8 py-4 rounded-xl shadow-md hover:-translate-y-0.5 transition-all min-h-[54px]"
      >
        Testar 15 dias grátis →
      </a>
      <p class="text-[0.9rem] text-slate-600 mt-2.5 font-medium">
        Todos os recursos liberados no período grátis
      </p>
    </div>
  </div>
</section>
