---
import { LINKS } from "../../constants/links";
import { CheckCircle2 } from "@lucide/astro";
import { Image } from "astro:assets";
import type { FeatureItem } from "../../data/landingData";

interface Props {
  features: FeatureItem[];
}

const { features } = Astro.props;
---

<section id="o-que-faz" class="py-14 md:py-20 bg-[#fafafa] scroll-mt-20">
  <div class="max-w-[1120px] mx-auto px-5">
    <div class="lp-reveal">
      <div class="text-center mb-8 sm:mb-12 md:mb-14">
        <h2
          class="text-[clamp(1.6rem,4.2vw,2.5rem)] font-extrabold text-[#1a3a5c] tracking-tight mb-2"
        >
          Veja o que o Van360 faz por você
        </h2>
        <p
          class="hidden md:block text-[1.05rem] text-slate-500 max-w-[560px] mx-auto"
        >
          Funcionalidades completas pensadas para a sua rotina no volante.
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-10 sm:gap-14 md:gap-16 lg:gap-20">
      {
        features.map((feat, i) => (
          <div class="lp-reveal">
            <div class="bg-white p-5 sm:p-7 md:p-8 lg:p-10 rounded-3xl border border-slate-100 shadow-sm flex flex-col md:grid md:grid-cols-2 md:items-center gap-5 sm:gap-6 md:gap-10 lg:gap-14">
              <div class="md:hidden text-left w-full">
                <span
                  class={`inline-flex items-center text-[10.5px] sm:text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full border mb-2.5 sm:mb-3 ${feat.tagColor}`}
                >
                  {feat.tag}
                </span>
                <h3 class="text-[1.3rem] sm:text-[1.55rem] font-extrabold text-[#1a3a5c] leading-tight">
                  {feat.headline}
                </h3>
              </div>

              <div
                class={`flex justify-center w-full ${
                  i % 2 === 0 ? "md:order-1" : "md:order-2"
                }`}
              >
                <div class="max-w-[230px] sm:max-w-[270px] md:max-w-[290px] lg:max-w-[310px] w-full feature-phone relative my-2 md:my-0">
                  {feat.balloonText && (
                    <div
                      class={`absolute bg-white/95 backdrop-blur-md rounded-xl md:rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] p-2 md:p-3 border border-slate-100 max-w-[145px] sm:max-w-[170px] md:max-w-[220px] z-20 pointer-events-none ${
                        i % 2 === 0
                          ? "-top-2 md:-top-4 -left-5 sm:-left-7 md:left-auto md:-right-16 lg:-right-24"
                          : "-top-2 md:-top-4 -left-5 sm:-left-7 md:-left-16 lg:-left-24 md:right-auto"
                      }`}
                      style={`animation: lp-countUp .6s cubic-bezier(0.34, 1.56, 0.64, 1) ${0.5 + i * 0.2}s both;`}
                    >
                      <div class="flex items-center gap-1.5 md:gap-2 mb-1 md:mb-1.5">
                        <div class="w-3.5 h-3.5 md:w-5 md:h-5 rounded-full bg-[#25D366]/15 flex items-center justify-center flex-shrink-0">
                          <svg
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="w-2 h-2 md:w-3 md:h-3 text-[#25D366]"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                          </svg>
                        </div>
                        <div class="text-[0.55rem] md:text-[0.65rem] font-bold text-slate-400 uppercase tracking-wider">
                          WhatsApp enviado
                        </div>
                      </div>
                      <div class="text-[0.65rem] md:text-[0.75rem] text-[#1a3a5c] font-medium leading-snug">
                        {feat.balloonText}
                      </div>
                    </div>
                  )}
                  <Image
                    src={feat.mockup}
                    alt={feat.alt}
                    widths={[320, 420, 640]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 320px"
                    class="w-full h-auto drop-shadow-xl"
                  />
                </div>
              </div>

              <div
                class={`text-left w-full flex-1 ${
                  i % 2 === 0 ? "md:order-2" : "md:order-1"
                }`}
              >
                <div class="hidden md:block">
                  <span
                    class={`inline-flex items-center text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full border mb-3.5 ${feat.tagColor}`}
                  >
                    {feat.tag}
                  </span>
                  <h3 class="text-[1.45rem] lg:text-[1.75rem] xl:text-[1.85rem] font-extrabold text-[#1a3a5c] mb-4 leading-tight">
                    {feat.headline}
                  </h3>
                </div>
                <ul class="space-y-2.5 sm:space-y-3 mt-2 md:mt-0">
                  {feat.bullets.map((b) => (
                    <li class="flex items-start gap-2.5 text-[0.92rem] sm:text-[0.98rem] md:text-[1rem] text-slate-600 leading-snug">
                      <CheckCircle2 class="w-4.5 h-4.5 sm:w-5 sm:h-5 text-emerald-600 shrink-0 mt-0.5" />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
                {feat.videoStory && (
                  <div class="mt-4">
                    <button
                      type="button"
                      class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-[#1a3a5c] hover:text-[#f59e0b] transition-all py-2 px-3.5 rounded-xl bg-slate-100/80 hover:bg-amber-50 border border-slate-200/80 hover:border-amber-300 shadow-2xs active:scale-[0.98] cursor-pointer"
                      data-video-story={JSON.stringify(feat.videoStory)}
                    >
                      <svg
                        class="w-4 h-4 fill-amber-500 text-amber-500"
                        viewBox="0 0 24 24"
                      >
                        <path d="M8 5v14l11-7z" />
                      </svg>
                      Ver demonstração em vídeo
                    </button>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="lp-reveal">
      <div class="text-center mt-10">
        <a
          href={LINKS.APP_REGISTER_URL}
          class="inline-flex items-center justify-center bg-[#f59e0b] hover:bg-[#d97706] text-[#1a1a1a] font-black text-base px-8 py-3.5 rounded-xl shadow-md hover:scale-[1.02] transition-all min-h-[46px]"
        >
          Começar 15 dias grátis →
        </a>
        <p class="text-xs text-slate-400 mt-2 font-medium">
          Sem cartão de crédito · Sem compromisso
        </p>
      </div>
    </div>
  </div>
</section>
