---
import { LINKS } from "../../constants/links";
import { Check, ArrowRight, ChevronDown } from "@lucide/astro";
import type { PlanFeatureItem } from "../../data/landingData";

interface Props {
  isPromoActive: boolean;
  originalVal: number;
  monthlyNormalVal: number;
  monthlyNormalFormatted: string;
  originalFormatted: string;
  yearlyTotalFormatted: string;
  annualSavingsVal: number;
  annualSavingsFormatted: string;
  regularAnnualTotalFormatted: string;
  annualMonthlyEquivFormatted: string;
  corePlanFeatures: PlanFeatureItem[];
  additionalPlanFeatures: PlanFeatureItem[];
}

const {
  isPromoActive,
  originalVal,
  monthlyNormalVal,
  monthlyNormalFormatted,
  originalFormatted,
  yearlyTotalFormatted,
  annualSavingsVal,
  annualSavingsFormatted,
  regularAnnualTotalFormatted,
  annualMonthlyEquivFormatted,
  corePlanFeatures,
  additionalPlanFeatures,
} = Astro.props;
---

<section
  id="pricing"
  class="py-14 md:py-20 bg-[#f9f9f7] border-b border-slate-100 scroll-mt-20"
>
  <div class="max-w-[540px] mx-auto px-4 sm:px-5 text-center">
    <div class="lp-reveal mb-6 sm:mb-8">
      <h2
        class="text-[clamp(1.5rem,3.8vw,2.2rem)] font-extrabold text-[#1a3a5c] tracking-tight mb-2"
      >
        Comece grátis. Pague só se gostar.
      </h2>
      <p
        class="text-[0.95rem] sm:text-[1.05rem] text-slate-500 max-w-[560px] mx-auto"
      >
        15 dias pra testar com seus dados reais. Sem cartão.
      </p>
    </div>

    <div class="lp-reveal max-w-sm sm:max-w-md mx-auto w-full mb-6">
      <div
        class="bg-slate-200/60 p-1 rounded-2xl flex items-center gap-1"
      >
        <button
          type="button"
          id="lp-tab-monthly"
          class="flex-1 py-2 px-3 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 bg-white text-[#1a3a5c] shadow-xs cursor-pointer"
        >
          Plano Mensal
        </button>
        <button
          type="button"
          id="lp-tab-yearly"
          class="relative flex-1 py-2 px-3 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 text-slate-500 hover:text-[#1a3a5c] cursor-pointer"
        >
          <span>Plano Anual</span>
          <span
            class="absolute -top-4 right-1 sm:right-2 px-2.5 py-0 rounded-full bg-[#002444] text-white text-[8px] font-semibold uppercase tracking-tight shadow-xs whitespace-nowrap"
          >
            mais popular
          </span>
        </button>
      </div>
    </div>

    <div
      id="lp-card-monthly"
      class="lp-reveal relative bg-white rounded-3xl p-6 sm:p-8 border-2 border-[#1a3a5c] shadow-[0_8px_30px_rgba(26,58,92,0.08)] text-left transition-all duration-300"
    >
      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-[#002444]">
          Plano Mensal
        </h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Pague só após os 15 dias, se quiser continuar
        </p>
      </div>

      <div class="mt-4 sm:mt-5 space-y-0.5">
        {
          isPromoActive && originalVal < monthlyNormalVal && (
            <p class="text-xs text-slate-400 line-through font-medium">
              De R$ {monthlyNormalFormatted}
            </p>
          )
        }
        <div class="flex items-baseline gap-1">
          <span
            class="text-3xl sm:text-4xl font-black text-[#002444] tracking-tight"
          >
            R$ {originalFormatted}
          </span>
          <span
            class="text-xs sm:text-sm font-semibold text-slate-500 shrink-0"
          >
            /mês
          </span>
        </div>
        <p class="text-xs text-slate-600 font-medium pt-0.5">
          No Pix ou no cartão de crédito
        </p>
      </div>

      <div class="mt-5 sm:mt-6">
        <a
          href={LINKS.APP_REGISTER_URL}
          class="w-full min-h-[46px] rounded-xl bg-[#002444] hover:bg-[#00172e] text-white font-bold text-sm shadow-md active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Começar 15 dias grátis</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="border-t border-slate-100 pt-5 mt-5 space-y-3">
        <p
          class="text-[11px] font-bold text-slate-400 uppercase tracking-wider"
        >
          Tudo o que resolve na sua van:
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          {
            corePlanFeatures.map((item) => (
              <li class="flex items-start gap-2.5 font-normal">
                <Check class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                <span class="text-slate-600">
                  <strong class="font-semibold text-slate-900">
                    {item.feature}:
                  </strong>{" "}
                  {item.benefit}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="pt-1.5">
          <button
            type="button"
            id="toggle-monthly-features-btn"
            class="w-full py-2 px-3 rounded-xl border border-slate-200 text-xs font-bold text-[#1a3a5c] hover:bg-slate-50 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
            aria-expanded="false"
          >
            <span id="toggle-monthly-features-text"
              >Ver mais benefícios inclusos</span
            >
            <ChevronDown
              class="w-3.5 h-3.5 transition-transform duration-200"
              id="toggle-monthly-features-icon"
            />
          </button>

          <div id="additional-monthly-features" class="hidden">
            <ul
              class="space-y-2.5 pt-3 text-xs sm:text-sm text-slate-700 border-t border-slate-100 mt-2"
            >
              {
                additionalPlanFeatures.map((item) => (
                  <li class="flex items-start gap-2.5 font-normal">
                    <Check class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                    <span class="text-slate-600">
                      <strong class="font-semibold text-slate-900">
                        {item.feature}:
                      </strong>{" "}
                      {item.benefit}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div
        class="bg-gradient-to-br from-blue-50/90 to-amber-50/40 rounded-2xl p-4 my-5 border border-blue-100/80 text-left"
      >
        <div class="flex items-center gap-2 mb-2">
          <span class="text-lg">🛡️</span>
          <span
            class="text-xs font-black text-[#1a3a5c] uppercase tracking-wider"
            >Garantia Blindada de 15 Dias</span
          >
        </div>
        <ul class="space-y-1.5 text-[12px] text-slate-600 font-medium">
          <li class="flex items-center gap-1.5 text-emerald-800">
            <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
            <span>Sem cartão de crédito no cadastro</span>
          </li>
          <li class="flex items-center gap-1.5 text-slate-700">
            <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
            <span>Suporte humano no WhatsApp para te ajudar</span>
          </li>
          <li class="flex items-center gap-1.5 text-slate-700">
            <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
            <span>Sem cobrança automática: só pague se quiser continuar</span>
          </li>
        </ul>
      </div>

      <p class="text-center text-[0.8rem] text-slate-400 font-medium">
        Sem cartão · Sem compromisso
      </p>
    </div>

    <div
      id="lp-card-yearly"
      class="hidden relative bg-white rounded-3xl p-6 sm:p-8 border-2 border-[#1a3a5c] shadow-[0_8px_30px_rgba(26,58,92,0.08)] text-left transition-all duration-300"
    >
      {
        annualSavingsVal > 0 && (
          <div class="absolute -top-3 right-6 px-3 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold tracking-tight border border-emerald-200/90 shadow-xs flex items-center gap-1.5">
            <span>Economize R$ {annualSavingsFormatted}</span>
          </div>
        )
      }

      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-[#002444]">
          Plano Anual
        </h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          1 ano pelo preço de 10 meses (pague só se gostar)
        </p>
      </div>

      <div class="mt-4 sm:mt-5 space-y-0.5">
        <p class="text-xs text-slate-400 line-through font-medium">
          De R$ {regularAnnualTotalFormatted}
        </p>
        <div class="flex items-baseline gap-1">
          <span
            class="text-3xl sm:text-4xl font-black text-[#002444] tracking-tight"
          >
            R$ {yearlyTotalFormatted}
          </span>
          <span
            class="text-xs sm:text-sm font-semibold text-slate-500 shrink-0"
          >
            /ano
          </span>
        </div>
        <p class="text-xs text-slate-600 font-medium pt-0.5">
          Equivale a <strong class="font-bold text-slate-900"
            >R$ {annualMonthlyEquivFormatted}/mês</strong
          > em até 12x ou à vista
        </p>
      </div>

      <div class="mt-5 sm:mt-6">
        <a
          href={LINKS.APP_REGISTER_URL}
          class="w-full min-h-[46px] rounded-xl bg-[#002444] hover:bg-[#00172e] text-white font-bold text-sm shadow-md active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Começar 15 dias grátis</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="border-t border-slate-100 pt-5 mt-5 space-y-3">
        <p
          class="text-[11px] font-bold text-slate-400 uppercase tracking-wider"
        >
          Tudo o que resolve na sua van:
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          {
            corePlanFeatures.map((item) => (
              <li class="flex items-start gap-2.5 font-normal">
                <Check class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                <span class="text-slate-600">
                  <strong class="font-semibold text-slate-900">
                    {item.feature}:
                  </strong>{" "}
                  {item.benefit}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="pt-1.5">
          <button
            type="button"
            id="toggle-yearly-features-btn"
            class="w-full py-2 px-3 rounded-xl border border-slate-200 text-xs font-bold text-[#1a3a5c] hover:bg-slate-50 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
            aria-expanded="false"
          >
            <span id="toggle-yearly-features-text"
              >Ver mais benefícios inclusos</span
            >
            <ChevronDown
              class="w-3.5 h-3.5 transition-transform duration-200"
              id="toggle-yearly-features-icon"
            />
          </button>

          <div id="additional-yearly-features" class="hidden">
            <ul
              class="space-y-2.5 pt-3 text-xs sm:text-sm text-slate-700 border-t border-slate-100 mt-2"
            >
              {
                additionalPlanFeatures.map((item) => (
                  <li class="flex items-start gap-2.5 font-normal">
                    <Check class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                    <span class="text-slate-600">
                      <strong class="font-semibold text-slate-900">
                        {item.feature}:
                      </strong>{" "}
                      {item.benefit}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div
        class="bg-gradient-to-br from-blue-50/90 to-amber-50/40 rounded-2xl p-4 my-5 border border-blue-100/80 text-left"
      >
        <div class="flex items-center gap-2 mb-2">
          <span class="text-lg">🛡️</span>
          <span
            class="text-xs font-black text-[#1a3a5c] uppercase tracking-wider"
            >Garantia Blindada de 15 Dias</span
          >
        </div>
        <ul class="space-y-1.5 text-[12px] text-slate-600 font-medium">
          <li class="flex items-center gap-1.5 text-emerald-800">
            <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
            <span>Sem cartão de crédito no cadastro</span>
          </li>
          <li class="flex items-center gap-1.5 text-slate-700">
            <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
            <span>Suporte humano no WhatsApp para te ajudar</span>
          </li>
          <li class="flex items-center gap-1.5 text-slate-700">
            <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
            <span>Sem cobrança automática: você só paga se aprovar</span>
          </li>
        </ul>
      </div>

      <p class="text-center text-[0.8rem] text-slate-400 font-medium">
        Sem cartão · Sem compromisso
      </p>
    </div>
  </div>
</section>

<script is:inline>
  const tabMonthly = document.getElementById("lp-tab-monthly");
  const tabYearly = document.getElementById("lp-tab-yearly");
  const cardMonthly = document.getElementById("lp-card-monthly");
  const cardYearly = document.getElementById("lp-card-yearly");

  function setPricingPeriod(period) {
    if (period === "monthly") {
      tabMonthly?.classList.add("bg-white", "text-[#1a3a5c]", "shadow-xs");
      tabMonthly?.classList.remove("text-slate-500");

      tabYearly?.classList.remove("bg-white", "text-[#1a3a5c]", "shadow-xs");
      tabYearly?.classList.add("text-slate-500");

      cardMonthly?.classList.remove("hidden");
      cardYearly?.classList.add("hidden");
    } else {
      tabYearly?.classList.add("bg-white", "text-[#1a3a5c]", "shadow-xs");
      tabYearly?.classList.remove("text-slate-500");

      tabMonthly?.classList.remove("bg-white", "text-[#1a3a5c]", "shadow-xs");
      tabMonthly?.classList.add("text-slate-500");

      cardYearly?.classList.remove("hidden");
      cardMonthly?.classList.add("hidden");
    }
  }

  tabMonthly?.addEventListener("click", () => setPricingPeriod("monthly"));
  tabYearly?.addEventListener("click", () => setPricingPeriod("yearly"));

  function setupFeaturesToggle(btnId, containerId, textId, iconId) {
    const btn = document.getElementById(btnId);
    const container = document.getElementById(containerId);
    const text = document.getElementById(textId);
    const icon = document.getElementById(iconId);

    if (btn && container) {
      btn.addEventListener("click", () => {
        const isHidden = container.classList.contains("hidden");
        if (isHidden) {
          container.classList.remove("hidden");
          btn.setAttribute("aria-expanded", "true");
          if (text) text.textContent = "Ocultar";
          if (icon) icon.classList.add("rotate-180");
        } else {
          container.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
          if (text) text.textContent = "Ver mais benefícios inclusos";
          if (icon) icon.classList.remove("rotate-180");
        }
      });
    }
  }

  setupFeaturesToggle(
    "toggle-monthly-features-btn",
    "additional-monthly-features",
    "toggle-monthly-features-text",
    "toggle-monthly-features-icon",
  );
  setupFeaturesToggle(
    "toggle-yearly-features-btn",
    "additional-yearly-features",
    "toggle-yearly-features-text",
    "toggle-yearly-features-icon",
  );
</script>
