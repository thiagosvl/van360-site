---
import { LINKS } from "../../constants/links";
import type { HowItWorksItem } from "../../data/landingData";

interface Props {
  howItWorks: HowItWorksItem[];
}

const { howItWorks } = Astro.props;
---

<section id="como-funciona" class="py-14 md:py-20 bg-white scroll-mt-20">
  <div class="max-w-[1000px] mx-auto px-5">
    <div class="lp-reveal text-center max-w-[620px] mx-auto mb-8 md:mb-12">
      <h2
        class="text-[clamp(1.7rem,4.2vw,2.5rem)] font-extrabold text-[#1a3a5c] tracking-tight leading-tight mb-3"
      >
        Como começar
      </h2>
      <p class="text-[1.05rem] sm:text-[1.12rem] text-slate-600 leading-relaxed">
        Três passos, e você não fica sozinho em nenhum deles.
      </p>
    </div>

    <ol class="grid md:grid-cols-3 gap-3 md:gap-6 max-w-[560px] md:max-w-none mx-auto">
      {
        howItWorks.map((step) => (
          <li class="lp-reveal flex md:flex-col items-start md:items-center gap-4 md:gap-3 md:text-center rounded-2xl bg-[#f6f8fb] border border-slate-200/70 p-4 md:p-6">
            <span class="w-11 h-11 rounded-full bg-[#1a3a5c] text-white text-lg font-extrabold flex items-center justify-center shrink-0">
              {step.n}
            </span>
            <span>
              <span class="block text-[1.1rem] font-bold text-[#1a3a5c] leading-tight mb-1">{step.title}</span>
              <span class="block text-[0.98rem] text-slate-600 leading-relaxed">{step.desc}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <!-- Suporte humano: responde a objeção "e se eu não souber mexer?" -->
    <div
      class="lp-reveal mt-6 md:mt-8 max-w-[560px] md:max-w-[760px] mx-auto rounded-3xl bg-emerald-50 border border-emerald-200 p-5 sm:p-7 flex flex-col md:flex-row items-center gap-4 md:gap-6 text-center md:text-left"
    >
      <span class="w-14 h-14 rounded-2xl bg-[#25D366] flex items-center justify-center shrink-0 shadow-md" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="white" class="w-8 h-8"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path></svg
        >
      </span>
      <div class="flex-1">
        <p class="text-[1.15rem] font-extrabold text-[#14532d] leading-tight mb-1">
          Não é bom com aplicativo? A gente te ajuda.
        </p>
        <p class="text-[0.98rem] text-emerald-900/80 leading-relaxed">
          Suporte de gente de verdade no WhatsApp, inclusive à noite, para tirar dúvidas e te ajudar a configurar.
        </p>
      </div>
      <a
        href={LINKS.WHATSAPP_SUPPORT_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center justify-center gap-2 bg-white text-emerald-800 font-bold text-[0.98rem] px-5 py-3 rounded-xl border border-emerald-300 hover:bg-emerald-100 transition-all min-h-[48px] w-full md:w-auto"
      >
        Falar no WhatsApp
      </a>
    </div>

    <div class="lp-reveal text-center mt-10">
      <a
        href={LINKS.APP_REGISTER_URL}
        class="inline-flex items-center justify-center bg-[#f59e0b] hover:bg-[#d97706] text-[#1a1a1a] font-black text-[1.05rem] px-8 py-4 rounded-xl shadow-md hover:-translate-y-0.5 transition-all min-h-[54px]"
      >
        Testar 15 dias grátis →
      </a>
      <p class="text-[0.9rem] text-slate-600 mt-2.5 font-medium">
        Sem cartão de crédito · Sem compromisso
      </p>
    </div>
  </div>
</section>
