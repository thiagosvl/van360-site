---
import { LINKS } from "../../constants/links";
import { Image } from "astro:assets";
import mockup3dHome from "../../assets/lp/mockup-3d-home.webp";
import type { HowItWorksItem } from "../../data/landingData";

interface Props {
  howItWorks: HowItWorksItem[];
}

const { howItWorks } = Astro.props;
---

<section id="como-funciona" class="py-14 md:py-20 bg-white scroll-mt-20">
  <div class="max-w-[1120px] mx-auto px-5 text-center">
    <div class="lp-reveal">
      <h2
        class="text-[clamp(1.8rem,4.5vw,2.5rem)] font-extrabold text-[#1a3a5c] tracking-tight mb-2"
      >
        Comece em 5 minutos
      </h2>
      <p
        class="text-[1.05rem] text-slate-500 max-w-[560px] mx-auto mb-10"
      >
        Três passos. Sem burocracia.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-[800px] mx-auto">
      {
        howItWorks.map((step) => (
          <div class="text-center">
            <div class="lp-reveal">
              <div class="w-[52px] h-[52px] rounded-full bg-[#1a3a5c] text-white text-xl font-extrabold inline-flex items-center justify-center mb-4">
                {step.n}
              </div>
              <h3 class="text-[1.05rem] font-bold text-[#1a3a5c] mb-2">
                {step.title}
              </h3>
              <p class="text-[0.9rem] text-slate-500">{step.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="lp-reveal mt-8 flex justify-center">
      <div class="max-w-[360px] md:max-w-[480px] w-full hero-phone">
        <Image
          src={mockup3dHome}
          alt="Dashboard do Van360 com primeiros passos"
          widths={[320, 480]}
          sizes="(max-width: 768px) 100vw, 480px"
          class="w-full h-auto"
        />
      </div>
    </div>

    <div class="lp-reveal">
      <div class="text-center mt-10">
        <a
          href={LINKS.APP_REGISTER_URL}
          class="inline-flex items-center justify-center bg-[#f59e0b] hover:bg-[#d97706] text-[#1a1a1a] font-black text-base px-8 py-3.5 rounded-xl shadow-md hover:scale-[1.02] transition-all min-h-[46px]"
        >
          Começar 15 dias grátis →
        </a>
        <p class="text-xs text-slate-400 mt-2 font-medium">
          Sem cartão de crédito · Sem compromisso
        </p>
      </div>
    </div>
  </div>
</section>
