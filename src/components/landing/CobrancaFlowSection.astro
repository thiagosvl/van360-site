---
import { LINKS } from "../../constants/links";
import { Image } from "astro:assets";
import assinatura from "../../assets/lp/v2/assinatura.webp";
import msgLembrete from "../../assets/lp/v2/msg-lembrete.webp";
import resumoParcelas from "../../assets/lp/v2/resumo-parcelas.webp";

/** Imagens geradas das telas e mensagens reais (projeto van360-videos, src/loja/LP.tsx). */
const passos = [
  {
    n: "1",
    titulo: "O pai assina o contrato pelo celular",
    texto: "O link chega no WhatsApp dele, ele assina com o dedo na tela e pronto. O cadastro do filho também é pelo seu link. Sem imprimir nada.",
    img: assinatura,
    alt: "Tela real do Van360 em que o pai assina o contrato com o dedo",
    selo: "No celular do pai",
  },
  {
    n: "2",
    titulo: "O lembrete do Pix chega no WhatsApp do pai",
    texto: "No dia do vencimento e, se atrasar, de novo. Você não precisa cobrar ninguém.",
    img: msgLembrete,
    alt: "Mensagem real do WhatsApp avisando o pai que a parcela vence hoje, com botão para copiar o Pix",
    selo: "Enviado automaticamente",
  },
  {
    n: "3",
    titulo: "Você vê quem pagou e quanto falta",
    texto: "Recebido, a receber e em atraso numa tela só. Pagou, o recibo com o seu logo vai pro pai em 1 toque.",
    img: resumoParcelas,
    alt: "Resumo de parcelas do Van360 com valor recebido, a receber e em atraso",
    selo: "No seu celular",
  },
];
---

<section id="como-funciona-mes" class="pt-10 pb-14 md:py-20 bg-white scroll-mt-20">
  <div class="max-w-[1120px] mx-auto px-5">
    <div class="lp-reveal max-w-[640px] mx-auto text-center mb-9 md:mb-12">
      <h2
        class="text-[clamp(1.7rem,4.2vw,2.5rem)] font-extrabold text-[#1a3a5c] tracking-tight leading-tight mb-3"
      >
        Como fica o seu mês com o Van360
      </h2>
      <p class="text-[1.05rem] sm:text-[1.12rem] text-slate-600 leading-relaxed">
        Menos papel, menos mensagem e você sabendo exatamente como está o dinheiro da van.
      </p>
    </div>

    <ol class="grid lg:grid-cols-3 gap-5 lg:gap-6 max-w-[480px] lg:max-w-none mx-auto">
      {
        passos.map((p) => (
          <li class="lp-reveal rounded-3xl bg-[#f6f8fb] border border-slate-200/80 overflow-hidden flex flex-col">
            <div class="relative px-3 sm:px-4 pt-11 pb-5 lg:h-[345px] flex items-center justify-center bg-gradient-to-b from-[#eef2f7] to-[#f6f8fb]">
              <span class="absolute top-3 left-4 inline-flex items-center gap-1.5 text-[0.78rem] font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-full px-2.5 py-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" />
                {p.selo}
              </span>
              <Image
                src={p.img}
                alt={p.alt}
                widths={[300, 600]}
                sizes="300px"
                class="w-full max-w-[280px] max-h-[270px] object-contain h-auto drop-shadow-[0_10px_20px_rgba(15,35,60,0.14)]"
              />
            </div>
            <div class="p-5 sm:p-6 pt-4 sm:pt-5">
              <div class="flex items-start gap-3 mb-2">
                <span class="w-8 h-8 rounded-full bg-[#1a3a5c] text-white font-extrabold text-[0.95rem] flex items-center justify-center shrink-0">
                  {p.n}
                </span>
                <h3 class="text-[1.15rem] font-extrabold text-[#1a3a5c] leading-tight pt-1">{p.titulo}</h3>
              </div>
              <p class="text-[0.98rem] text-slate-700 leading-relaxed">{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="lp-reveal text-center mt-10">
      <a
        href={LINKS.APP_REGISTER_URL}
        class="inline-flex items-center justify-center bg-[#f59e0b] hover:bg-[#d97706] text-[#1a1a1a] font-black text-[1.05rem] px-8 py-4 rounded-xl shadow-md hover:-translate-y-0.5 transition-all min-h-[54px]"
      >
        Testar 15 dias grátis →
      </a>
      <p class="text-[0.9rem] text-slate-600 mt-2.5 font-medium">
        Tudo isso já funciona no período grátis.
      </p>
    </div>
  </div>
</section>
