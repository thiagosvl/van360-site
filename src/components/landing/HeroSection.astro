---
import { LINKS } from "../../constants/links";
import { Image } from "astro:assets";
import { Check } from "@lucide/astro";
import mockupHero from "../../assets/lp/v2/parcelas.webp";
import { heroVideoStory } from "../../data/landingData";

const chips = [
  { icon: "📋", text: "Quem pagou e quem deve" },
  { icon: "✍️", text: "Contrato sem papel" },
  { icon: "💬", text: "Lembrete no WhatsApp" },
];
---

<section
  class="relative overflow-hidden pt-5 sm:pt-8 lg:pt-14 pb-6 lg:pb-20 bg-gradient-to-b from-[#f0f4f8] to-white"
>
  <div class="max-w-[1120px] mx-auto px-5">
    <div
      class="flex flex-col lg:grid lg:grid-cols-[1.15fr_0.85fr] items-center gap-7 lg:gap-12"
    >
      <!-- Texto -->
      <div class="w-full max-w-[640px] mx-auto lg:mx-0 text-center lg:text-left">
        <div
          class="inline-flex items-center gap-1.5 bg-[#f59e0b]/15 px-3.5 py-1.5 rounded-full text-[#92400e] font-bold text-[13px] mb-4"
        >
          🚐 Para motoristas do transporte escolar
        </div>

        <h1
          style="text-wrap: balance;"
          class="text-[1.85rem] leading-[1.12] sm:text-[2.4rem] lg:text-[3rem] lg:leading-[1.08] font-black tracking-tight text-[#1a3a5c] mb-4"
        >
          Mensalidades, contratos e alunos da sua van,
          <span class="text-[#d97706]">tudo no celular.</span>
        </h1>

        <p
          class="text-[1.06rem] sm:text-[1.15rem] lg:text-[1.2rem] text-slate-700 leading-relaxed mb-5 lg:max-w-[560px]"
        >
          Veja na hora quem pagou e quem deve, mande o contrato para o pai assinar
          no celular e deixe o Van360 lembrar os pais do Pix pelo WhatsApp.
        </p>

        <ul class="grid grid-cols-3 sm:flex sm:flex-wrap justify-center lg:justify-start gap-2 mb-6">
          {
            chips.map((c) => (
              <li class="flex flex-col sm:flex-row items-center gap-1 sm:gap-1.5 bg-white border border-slate-200 rounded-2xl sm:rounded-full px-2 sm:px-3 py-2 sm:py-1.5 text-[0.8rem] sm:text-[0.92rem] leading-tight font-bold text-[#1a3a5c] shadow-sm text-center">
                <span aria-hidden="true" class="text-[1.15rem] sm:text-base">{c.icon}</span>
                {c.text}
              </li>
            ))
          }
        </ul>

        <div
          class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3"
        >
          <a
            href={LINKS.APP_REGISTER_URL}
            class="lp-cta-glow inline-flex items-center justify-center bg-[#f59e0b] hover:bg-[#d97706] text-[#1a1a1a] font-black text-[1.1rem] px-8 py-4 rounded-xl hover:-translate-y-0.5 transition-all min-h-[56px] shadow-xl"
          >
            Testar 15 dias grátis →
          </a>
          <button
            type="button"
            data-video-story={JSON.stringify(heroVideoStory)}
            class="inline-flex items-center justify-center gap-2.5 text-[#1a3a5c] font-bold text-base px-5 py-2 sm:py-3.5 rounded-xl sm:bg-white sm:border border-slate-200 hover:border-[#f59e0b] sm:shadow-sm transition-all min-h-[44px] sm:min-h-[52px] cursor-pointer"
          >
            <span
              class="w-8 h-8 rounded-full bg-[#1a3a5c] text-white flex items-center justify-center shrink-0"
            >
              <svg class="w-3.5 h-3.5 ml-0.5 fill-current" viewBox="0 0 24 24"
                ><path d="M8 5v14l11-7z"></path></svg
              >
            </span>
            Ver o app funcionando
          </button>
        </div>

        <ul
          class="flex flex-wrap justify-center lg:justify-start gap-x-4 gap-y-1.5 mt-4 text-[0.92rem] font-semibold text-slate-700"
        >
          <li class="inline-flex items-center gap-1.5">
            <Check class="w-4 h-4 text-emerald-600" stroke-width={3} /> Sem cartão
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Check class="w-4 h-4 text-emerald-600" stroke-width={3} /> Sem fidelidade
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Check class="w-4 h-4 text-emerald-600" stroke-width={3} /> Suporte no WhatsApp
          </li>
        </ul>

        <p class="hidden lg:block mt-6 text-[0.95rem] text-slate-600">
          <strong class="text-[#1a3a5c]">Mais de 500 motoristas</strong> já organizam
          a van com o Van360.
        </p>
      </div>

      <!-- Visual: tela real de Parcelas + dois avisos pequenos nas bordas -->
      <div class="relative w-full max-w-[250px] sm:max-w-[300px] lg:max-w-[340px] mx-auto">
        <div
          class="relative max-h-[360px] sm:max-h-[460px] lg:max-h-none overflow-hidden"
        >
          <Image
            src={mockupHero}
            alt="Tela de Parcelas do Van360 mostrando quanto já foi recebido e quem está em atraso"
            loading="eager"
            fetchpriority="high"
            widths={[320, 480, 680]}
            sizes="(min-width: 1024px) 340px, (min-width: 640px) 300px, 250px"
            class="w-full h-auto select-none"
          />
          <div
            class="lg:hidden absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-white to-transparent pointer-events-none"
          >
          </div>
        </div>

        <!-- Aviso: lembrete enviado (borda esquerda, altura da lista) -->
        <div
          class="absolute -left-12 sm:-left-20 lg:-left-24 top-[58%] lg:top-[62%] max-w-[150px] rounded-xl bg-white border border-slate-200 shadow-[0_10px_24px_rgba(15,35,60,0.16)] px-2.5 py-2 text-left"
          style="animation: lp-countUp .6s cubic-bezier(0.34, 1.56, 0.64, 1) .5s both;"
          aria-hidden="true"
        >
          <div class="flex items-center gap-1.5">
            <span class="w-5 h-5 rounded-full bg-[#25D366] text-white flex items-center justify-center shrink-0">
              <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            <span class="text-[0.76rem] font-bold text-slate-800 leading-tight">Lembrete enviado</span>
          </div>
          <div class="text-[0.7rem] text-slate-500 mt-0.5 leading-snug">no WhatsApp do pai, com seu Pix</div>
        </div>

        <!-- Aviso: contrato assinado (borda direita, no topo) -->
        <div
          class="absolute -right-12 sm:-right-20 lg:-right-20 top-[6%] max-w-[146px] rounded-xl bg-white border border-slate-200 shadow-[0_10px_24px_rgba(15,35,60,0.16)] px-2.5 py-2 text-left"
          style="animation: lp-countUp .6s cubic-bezier(0.34, 1.56, 0.64, 1) .8s both;"
          aria-hidden="true"
        >
          <div class="flex items-center gap-1.5">
            <span class="w-5 h-5 rounded-full bg-[#1a3a5c] text-white flex items-center justify-center shrink-0 text-[0.65rem]">✍️</span>
            <span class="text-[0.76rem] font-bold text-slate-800 leading-tight">Contrato assinado</span>
          </div>
          <div class="text-[0.7rem] text-slate-500 mt-0.5 leading-snug">pelo pai, no celular</div>
        </div>
      </div>

      <p class="lg:hidden text-center text-[0.95rem] text-slate-600 -mt-2 mb-2">
        <strong class="text-[#1a3a5c]">Mais de 500 motoristas</strong> já organizam a
        van com o Van360.
      </p>
    </div>
  </div>
</section>
