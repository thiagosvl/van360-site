---
import { LINKS } from "../../constants/links";
import { videoTestimonials } from "../../data/landingData";
---

<section
  id="depoimentos"
  class="py-14 md:py-20 bg-[#1a3a5c] text-white scroll-mt-20 overflow-hidden"
>
  <div class="max-w-[1120px] mx-auto px-5">
    <div class="lp-reveal max-w-[640px] mx-auto text-center mb-8 md:mb-12">
      <div
        class="inline-flex items-center gap-1.5 bg-[#f59e0b] px-3.5 py-1 rounded-full text-[#1a1a1a] font-bold text-[13px] mb-3"
      >
        Clientes de verdade
      </div>
      <h2
        class="text-[clamp(1.7rem,4.2vw,2.5rem)] font-extrabold tracking-tight leading-tight mb-3 text-white"
      >
        Ouça quem já usa o Van360 no dia a dia
      </h2>
      <p class="text-[1.05rem] sm:text-[1.12rem] text-white/80 leading-relaxed">
        Motoristas escolares de diferentes cidades contando como ficou a rotina.
      </p>
    </div>

    <div class="lp-reveal relative">
      <div
        id="testimonial-track"
        class="flex lg:grid lg:grid-cols-3 lg:max-w-[880px] lg:mx-auto gap-4 lg:gap-6 overflow-x-auto lg:overflow-visible snap-x snap-mandatory hide-scrollbar -mx-5 px-5 lg:mx-0 lg:px-0 pb-2"
      >
        {
          videoTestimonials.map((t, i) => (
            <figure
              class="snap-center shrink-0 w-[78%] sm:w-[46%] lg:w-auto"
              data-testimonial-card={i}
            >
              <div class="relative aspect-[9/16] rounded-3xl overflow-hidden bg-slate-900 shadow-[0_16px_40px_rgba(0,0,0,0.35)] border border-white/10">
                <video
                  src={`${t.videoUrl}#t=0.5`}
                  poster={t.poster}
                  playsinline
                  preload="metadata"
                  class="w-full h-full object-cover"
                  data-testimonial-video
                />
                <button
                  type="button"
                  class="absolute inset-0 flex flex-col items-center justify-end pb-6 bg-gradient-to-t from-black/80 via-black/10 to-transparent cursor-pointer group"
                  data-testimonial-play
                  aria-label={`Assistir depoimento de ${t.name}`}
                >
                  <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-white text-[#1a3a5c] flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                    <svg class="w-7 h-7 ml-1 fill-current" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                  <span class="text-left w-full px-5">
                    <span class="block text-[1.2rem] font-extrabold text-white leading-tight">
                      {t.name}
                    </span>
                    <span class="block text-[0.95rem] text-white/85 mt-0.5">
                      {t.city}
                    </span>
                  </span>
                </button>
              </div>
              {t.quote && (
                <figcaption class="mt-3 px-1 text-[1rem] text-white/90 leading-snug">
                  “{t.quote}”
                </figcaption>
              )}
            </figure>
          ))
        }
      </div>

      <div class="flex lg:hidden items-center justify-center gap-2 mt-4" id="testimonial-dots">
        {
          videoTestimonials.map((_, i) => (
            <button
              type="button"
              class={`h-2.5 rounded-full transition-all ${i === 0 ? "w-6 bg-[#f59e0b]" : "w-2.5 bg-white/40"}`}
              data-testimonial-dot={i}
              aria-label={`Ver depoimento ${i + 1}`}
            />
          ))
        }
      </div>
    </div>

    <div class="lp-reveal text-center mt-10">
      <a
        href={LINKS.APP_REGISTER_URL}
        class="inline-flex items-center justify-center bg-[#f59e0b] hover:bg-[#d97706] text-[#1a1a1a] font-black text-[1.05rem] px-8 py-4 rounded-xl shadow-md hover:-translate-y-0.5 transition-all min-h-[54px]"
      >
        Quero testar também →
      </a>
      <p class="text-[0.9rem] text-white/75 mt-2.5 font-medium">
        15 dias grátis · Sem cartão · Sem fidelidade
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const track = document.getElementById("testimonial-track");
    if (!track) return;
    const cards = track.querySelectorAll("[data-testimonial-card]");
    const dots = document.querySelectorAll("[data-testimonial-dot]");
    const videos = track.querySelectorAll("[data-testimonial-video]");

    function pauseOthers(current) {
      videos.forEach((v) => {
        if (v !== current && !v.paused) v.pause();
      });
    }

    cards.forEach((card) => {
      const video = card.querySelector("[data-testimonial-video]");
      const overlay = card.querySelector("[data-testimonial-play]");
      if (!video || !overlay) return;

      overlay.addEventListener("click", () => {
        pauseOthers(video);
        video.muted = false;
        video.controls = true;
        overlay.classList.add("hidden");
        const p = video.play();
        if (p && p.catch) p.catch(() => {});
        if (window.dataLayer) {
          window.dataLayer.push({ event: "lp_testimonial_play", testimonial: card.getAttribute("data-testimonial-card") });
        }
      });

      video.addEventListener("play", () => pauseOthers(video));
      video.addEventListener("ended", () => {
        video.controls = false;
        overlay.classList.remove("hidden");
      });
    });

    function setDot(idx) {
      dots.forEach((d, i) => {
        d.className =
          "h-2.5 rounded-full transition-all " +
          (i === idx ? "w-6 bg-[#f59e0b]" : "w-2.5 bg-white/40");
      });
    }

    if ("IntersectionObserver" in window && dots.length) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting && e.intersectionRatio > 0.6) {
              const idx = Number(e.target.getAttribute("data-testimonial-card"));
              setDot(idx);
              // pausa o vídeo que saiu da tela ao arrastar
              videos.forEach((v, i) => {
                if (i !== idx && !v.paused) v.pause();
              });
            }
          });
        },
        { root: track, threshold: [0.6] },
      );
      cards.forEach((c) => io.observe(c));
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = Number(dot.getAttribute("data-testimonial-dot"));
        const card = cards[idx];
        if (card) track.scrollTo({ left: card.offsetLeft - 20, behavior: "smooth" });
      });
    });
  })();
</script>
