---
import FloatingVideoBubble from "./video/FloatingVideoBubble.astro";

interface Props {
  previewUrl: string;
  videosData?: Array<{ url: string; title?: string }>;
  videoUrls?: string[];
  fullUrl?: string;
  tooltipText?: string;
  positionClasses?: string;
  showCta?: boolean;
  ctaText?: string;
  ctaLink?: string;
  loop?: boolean;
  requireScrollOnMobile?: boolean;
  dismissible?: boolean;
  storageKey?: string;
}

const props = Astro.props;
---

<FloatingVideoBubble {...props} />
