---
interface Props {
  previewUrl: string;
  videosData?: Array<{ url: string; title?: string }>;
  videoUrls?: string[];
  fullUrl?: string;
  tooltipText?: string;
  positionClasses?: string;
  showCta?: boolean;
  ctaText?: string;
  ctaLink?: string;
  loop?: boolean;
  requireScrollOnMobile?: boolean;
  dismissible?: boolean;
  storageKey?: string;
}

const {
  previewUrl,
  videosData,
  videoUrls = [],
  fullUrl,
  tooltipText = "Veja como funciona",
  positionClasses = "fixed bottom-6 left-6 z-50",
  showCta = true,
  ctaText = "Testar grátis por 15 dias",
  ctaLink = "/cadastro",
  loop = true,
  requireScrollOnMobile = true,
  dismissible = true,
  storageKey,
} = Astro.props;

const rawVideos = videosData || (videoUrls.length > 0 ? videoUrls : (fullUrl ? [fullUrl] : []));
const uniqueId = `bubble-${Math.random().toString(36).substring(2, 9)}`;
---

<div
  id={uniqueId}
  class={`${positionClasses} flex items-center select-none`}
  data-active-videos={JSON.stringify(rawVideos)}
  data-loop={loop ? "true" : "false"}
  data-require-scroll={requireScrollOnMobile ? "true" : "false"}
  data-show-cta={showCta ? "true" : "false"}
  data-cta-text={ctaText}
  data-cta-link={ctaLink}
  data-storage-key={storageKey || ""}
  style="z-index: 50;"
>
  <div
    class="video-widget flex items-center cursor-grab active:cursor-grabbing transition-transform duration-300 opacity-0 pointer-events-none"
    style="transform: translateX(-100px);"
  >
    <div
      class="video-bubble relative rounded-full overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.3)] border-4 border-white transition-transform hover:scale-105 group w-[72px] h-[72px] sm:w-[84px] sm:h-[84px] flex-shrink-0 z-20 bg-black cursor-pointer"
      aria-label="Assistir demonstração"
    >
      <div class="absolute inset-0 bg-[#f59e0b] rounded-full animate-ping opacity-20 z-0 pointer-events-none"></div>
      <video
        src={previewUrl}
        autoplay
        loop
        muted
        playsinline
        class="w-full h-full object-cover relative z-10 pointer-events-none"
      ></video>
    </div>

    <div
      class="video-tooltip z-10 transition-[max-width,opacity,margin] duration-300 ease-out flex items-center overflow-hidden max-w-0 opacity-0 -ml-16"
    >
      <div
        class="bg-black/90 text-white text-[10px] sm:text-[11px] uppercase font-bold pl-10 pr-2.5 py-2.5 rounded-r-full whitespace-nowrap shadow-xl tracking-widest border-y-2 border-r-2 border-white/10 flex items-center gap-2"
      >
        <span class="tooltip-label cursor-pointer hover:text-white/80 transition-colors">
          {tooltipText}
        </span>

        {dismissible && (
          <button
            type="button"
            class="action-dismiss-bubble p-1 text-white/50 hover:text-white hover:bg-white/20 rounded-full transition-all active:scale-90 cursor-pointer"
            aria-label="Fechar dica de vídeo"
          >
            <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ uniqueId }}>
  (function() {
    const container = document.getElementById(uniqueId);
    if (!container) return;

    const storageKey = container.getAttribute('data-storage-key');
    if (storageKey) {
      try {
        if (localStorage.getItem(storageKey) === 'true') {
          container.remove();
          return;
        }
      } catch (e) {}
    }

    const activeVideos = JSON.parse(container.getAttribute('data-active-videos') || '[]');
    const loop = container.getAttribute('data-loop') === 'true';
    const requireScroll = container.getAttribute('data-require-scroll') === 'true';
    const showCta = container.getAttribute('data-show-cta') !== 'false';
    const ctaText = container.getAttribute('data-cta-text') || undefined;
    const ctaLink = container.getAttribute('data-cta-link') || undefined;

    const widget = container.querySelector('.video-widget');
    const bubble = container.querySelector('.video-bubble');
    const tooltip = container.querySelector('.video-tooltip');
    const tooltipLabel = container.querySelector('.tooltip-label');
    const btnDismiss = container.querySelector('.action-dismiss-bubble');

    if (btnDismiss) {
      const stopPropagation = (e) => e.stopPropagation();
      btnDismiss.addEventListener('mousedown', stopPropagation);
      btnDismiss.addEventListener('touchstart', stopPropagation, { passive: true });
      btnDismiss.addEventListener('click', (e) => {
        e.stopPropagation();
        widget.classList.add('opacity-0', 'pointer-events-none');
        widget.style.transform = 'translateX(-100px)';
        if (storageKey) {
          try {
            localStorage.setItem(storageKey, 'true');
          } catch (err) {}
        }
        setTimeout(() => container.remove(), 300);
      });
    }

    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let currentX = 0;
    let currentY = 0;
    let offsetX = 0;
    let offsetY = 0;
    let hasShownTooltip = false;

    const showWidget = () => {
      widget.classList.remove('opacity-0', 'pointer-events-none');
      widget.style.transform = 'translate(0px, 0px)';

      if (!hasShownTooltip) {
        setTimeout(() => {
          tooltip.classList.remove('max-w-0', 'opacity-0', '-ml-16');
          tooltip.classList.add('max-w-[280px]', 'opacity-100', '-ml-6');
          hasShownTooltip = true;
        }, 800);
      }
    };

    const checkScrollVisibility = () => {
      if (!requireScroll || window.innerWidth >= 640) {
        showWidget();
        return;
      }

      if (window.scrollY > 100) {
        showWidget();
      } else {
        widget.classList.add('opacity-0', 'pointer-events-none');
        widget.style.transform = 'translateX(-100px)';
      }
    };

    window.addEventListener('scroll', checkScrollVisibility, { passive: true });
    window.addEventListener('resize', checkScrollVisibility, { passive: true });
    checkScrollVisibility();

    const onDragStart = (e) => {
      isDragging = false;
      const clientX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
      const clientY = e.type.startsWith('touch') ? e.touches[0].clientY : e.clientY;
      dragStartX = clientX - offsetX;
      dragStartY = clientY - offsetY;

      document.addEventListener('mousemove', onDragMove);
      document.addEventListener('mouseup', onDragEnd);
      document.addEventListener('touchmove', onDragMove, { passive: false });
      document.addEventListener('touchend', onDragEnd);
    };

    const onDragMove = (e) => {
      const clientX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
      const clientY = e.type.startsWith('touch') ? e.touches[0].clientY : e.clientY;
      currentX = clientX - dragStartX;
      currentY = clientY - dragStartY;

      if (Math.abs(currentX - offsetX) > 5 || Math.abs(currentY - offsetY) > 5) {
        isDragging = true;
      }

      offsetX = currentX;
      offsetY = currentY;

      widget.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
      if (e.cancelable) e.preventDefault();
    };

    const onDragEnd = () => {
      document.removeEventListener('mousemove', onDragMove);
      document.removeEventListener('mouseup', onDragEnd);
      document.removeEventListener('touchmove', onDragMove);
      document.removeEventListener('touchend', onDragEnd);
    };

    bubble.addEventListener('mousedown', onDragStart);
    bubble.addEventListener('touchstart', onDragStart, { passive: true });

    const handleClick = () => {
      if (isDragging) return;
      if (typeof window.openVideoStory === 'function') {
        window.openVideoStory({
          videos: activeVideos,
          loop,
          showCta,
          ctaText,
          ctaLink
        });
      }
    };

    bubble.addEventListener('click', handleClick);
    tooltip.addEventListener('click', handleClick);
  })();
</script>
