---
interface Props {
  defaultCtaText?: string;
  defaultCtaLink?: string;
}

const {
  defaultCtaText = "Testar grátis por 15 dias",
  defaultCtaLink = "/cadastro",
} = Astro.props;
---

<div
  id="van360-video-stories-modal"
  class="fixed inset-0 z-[99999] flex items-center justify-center bg-black/90 backdrop-blur-md p-0 md:p-8 opacity-0 pointer-events-none transition-opacity duration-300"
  data-default-cta-text={defaultCtaText}
  data-default-cta-link={defaultCtaLink}
>
  <div
    class="modal-card relative w-full h-full md:max-w-[420px] md:h-auto md:aspect-[9/16] bg-black md:rounded-[2rem] overflow-hidden shadow-2xl flex flex-col justify-center border border-white/10 group transition-all duration-300 scale-95 translate-y-4 opacity-0"
  >
    <div class="absolute top-0 left-0 right-0 h-[calc(8rem+env(safe-area-inset-top,0px))] bg-gradient-to-b from-black/80 to-transparent z-40 pointer-events-none"></div>

    <div class="absolute top-0 left-0 right-0 p-4 pt-[calc(1.25rem+env(safe-area-inset-top,0px))] z-50 pointer-events-none flex flex-col gap-3">
      <div class="stories-progress-bars flex gap-1.5 w-full pointer-events-auto"></div>

      <div class="flex justify-between items-center w-full">
        <button
          type="button"
          class="action-mute bg-black/30 hover:bg-black/60 text-white rounded-full p-2.5 backdrop-blur-md transition-all border border-white/10 pointer-events-auto active:scale-95"
          aria-label="Alternar som"
        >
          <svg class="icon-volume-on w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14M11 5L6 9H2v6h4l5 4V5z" />
          </svg>
          <svg class="icon-volume-mute w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5zM23 9l-6 6m0-6l6 6" />
          </svg>
        </button>

        <span class="story-title text-white/90 text-xs font-semibold truncate max-w-[200px] px-2 drop-shadow hidden"></span>

        <button
          type="button"
          class="action-close bg-black/30 hover:bg-black/60 text-white rounded-full p-2.5 backdrop-blur-md transition-all border border-white/10 pointer-events-auto active:scale-95"
          aria-label="Fechar"
        >
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="absolute inset-0 z-40 flex touch-manipulation">
      <div class="nav-zone-prev w-[30%] h-full cursor-pointer flex items-center justify-start group/navleft">
        <div class="nav-btn-prev hidden md:flex ml-4 w-10 h-10 rounded-full bg-black/20 backdrop-blur-sm items-center justify-center text-white/50 group-hover/navleft:bg-black/50 group-hover/navleft:text-white transition-all border border-white/5 opacity-0 group-hover:opacity-100 duration-300">
          <svg class="w-6 h-6 mr-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </div>
      </div>

      <div class="nav-zone-play w-[40%] h-full cursor-pointer flex items-center justify-center">
        <div class="play-state-overlay bg-black/50 backdrop-blur-md rounded-full p-5 text-white shadow-xl border border-white/10 opacity-0 scale-50 transition-all duration-300 pointer-events-none">
          <svg class="w-10 h-10 ml-0.5" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>

      <div class="nav-zone-next w-[30%] h-full cursor-pointer flex items-center justify-end group/navright">
        <div class="nav-btn-next hidden md:flex mr-4 w-10 h-10 rounded-full bg-black/20 backdrop-blur-sm items-center justify-center text-white/50 group-hover/navright:bg-black/50 group-hover/navright:text-white transition-all border border-white/5 opacity-0 group-hover:opacity-100 duration-300">
          <svg class="w-6 h-6 ml-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </div>
      </div>
    </div>

    <video
      class="main-video w-full h-full object-contain bg-black"
      playsinline
    ></video>

    <div class="cta-gradient absolute bottom-0 left-0 right-0 h-[calc(12rem+env(safe-area-inset-bottom,0px))] bg-gradient-to-t from-black/90 to-transparent z-40 pointer-events-none"></div>

    <div class="cta-container absolute bottom-0 left-0 right-0 z-50 flex flex-col px-6 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] pointer-events-none">
      <a
        href={defaultCtaLink}
        class="video-cta w-full bg-[#f59e0b] hover:bg-[#d97706] text-[#1a1a1a] font-bold py-4 rounded-xl shadow-[0_4px_20px_rgba(245,158,11,.4)] transition-all text-center text-[0.95rem] active:scale-[0.98] pointer-events-auto flex items-center justify-center gap-2"
      >
        {defaultCtaText}
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('van360-video-stories-modal');
    if (!modal) return;

    const card = modal.querySelector('.modal-card');
    const video = modal.querySelector('.main-video');
    const btnMute = modal.querySelector('.action-mute');
    const iconVolumeOn = modal.querySelector('.icon-volume-on');
    const iconVolumeMute = modal.querySelector('.icon-volume-mute');
    const btnClose = modal.querySelector('.action-close');
    const zonePrev = modal.querySelector('.nav-zone-prev');
    const zoneNext = modal.querySelector('.nav-zone-next');
    const zonePlay = modal.querySelector('.nav-zone-play');
    const navBtnPrev = modal.querySelector('.nav-btn-prev');
    const navBtnNext = modal.querySelector('.nav-btn-next');
    const overlayPlay = modal.querySelector('.play-state-overlay');
    const barsContainer = modal.querySelector('.stories-progress-bars');
    const ctaContainer = modal.querySelector('.cta-container');
    const ctaGradient = modal.querySelector('.cta-gradient');
    const ctaLink = modal.querySelector('.video-cta');

    const defaultCtaText = modal.getAttribute('data-default-cta-text') || 'Testar grátis por 15 dias';
    const defaultCtaLink = modal.getAttribute('data-default-cta-link') || '/cadastro';

    let activeVideos = [];
    let loop = false;
    let isOpen = false;
    let isMuted = false;
    let currentIndex = 0;
    let isPlaying = true;
    let animationFrameId = null;

    const setupBars = (count) => {
      barsContainer.innerHTML = '';
      if (count <= 0) return;

      for (let i = 0; i < count; i++) {
        const barContainer = document.createElement('div');
        barContainer.className = 'story-bar-container h-3 flex items-center flex-1 cursor-pointer';
        barContainer.setAttribute('data-index', String(i));

        const barTrack = document.createElement('div');
        barTrack.className = 'h-1 w-full bg-white/30 rounded-full overflow-hidden backdrop-blur-sm pointer-events-none';

        const barFill = document.createElement('div');
        barFill.className = 'story-bar-fill h-full bg-white rounded-full';
        barFill.style.width = '0%';

        barTrack.appendChild(barFill);
        barContainer.appendChild(barTrack);
        barsContainer.appendChild(barContainer);

        barContainer.addEventListener('click', (e) => {
          e.stopPropagation();
          const targetIdx = parseInt(barContainer.getAttribute('data-index') || '0', 10);
          if (targetIdx !== currentIndex) {
            loadVideo(targetIdx);
          }
        });
      }
    };

    const updatePlayProgress = () => {
      if (!isOpen || video.paused || video.ended || !video.duration) {
        animationFrameId = null;
        return;
      }

      const progress = (video.currentTime / video.duration) * 100;
      const barFills = modal.querySelectorAll('.story-bar-fill');
      if (barFills[currentIndex]) {
        barFills[currentIndex].style.width = `${progress}%`;
      }

      animationFrameId = requestAnimationFrame(updatePlayProgress);
    };

    const updateProgressBars = () => {
      const barFills = modal.querySelectorAll('.story-bar-fill');
      barFills.forEach((bar, idx) => {
        if (idx < currentIndex) {
          bar.style.width = '100%';
        } else if (idx > currentIndex) {
          bar.style.width = '0%';
        }
      });
    };

    const storyTitleEl = modal.querySelector('.story-title');

    const loadVideo = (index) => {
      const currentItem = activeVideos[index];
      if (!currentItem) return;

      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }

      currentIndex = index;
      video.src = currentItem.url;
      video.loop = activeVideos.length === 1 && loop;
      video.load();
      video.play().catch(() => {
        video.muted = true;
        isMuted = true;
        iconVolumeOn.classList.add('hidden');
        iconVolumeMute.classList.remove('hidden');
        video.play().catch(() => {});
      });
      isPlaying = true;
      overlayPlay.classList.add('opacity-0', 'scale-50', 'pointer-events-none');
      overlayPlay.classList.remove('opacity-100', 'scale-100');
      updateProgressBars();

      if (storyTitleEl) {
        if (currentItem.title) {
          storyTitleEl.textContent = currentItem.title;
          storyTitleEl.classList.remove('hidden');
        } else {
          storyTitleEl.textContent = '';
          storyTitleEl.classList.add('hidden');
        }
      }

      animationFrameId = requestAnimationFrame(updatePlayProgress);
    };

    const handleNext = () => {
      if (currentIndex < activeVideos.length - 1) {
        loadVideo(currentIndex + 1);
      } else if (loop) {
        loadVideo(0);
      } else {
        video.pause();
        isPlaying = false;
      }
    };

    const handlePrev = () => {
      if (currentIndex > 0) {
        loadVideo(currentIndex - 1);
      } else {
        video.currentTime = 0;
        const barFills = modal.querySelectorAll('.story-bar-fill');
        if (barFills[0]) barFills[0].style.width = '0%';
      }
    };

    const togglePlay = () => {
      if (isPlaying) {
        video.pause();
        isPlaying = false;
        overlayPlay.classList.remove('opacity-0', 'scale-50', 'pointer-events-none');
        overlayPlay.classList.add('opacity-100', 'scale-100');
      } else {
        video.play().catch(() => {});
        isPlaying = true;
        overlayPlay.classList.add('opacity-0', 'scale-50', 'pointer-events-none');
        overlayPlay.classList.remove('opacity-100', 'scale-100');
      }
    };

    const openVideoStory = (options = {}) => {
      let rawVideos = options.videosData || options.videos || options.videoUrls || [];
      if (typeof rawVideos === 'string') rawVideos = [rawVideos];
      if (!rawVideos.length && options.videoUrl) rawVideos = [options.videoUrl];
      if (!rawVideos.length) return;

      activeVideos = rawVideos.map((item) => {
        if (typeof item === 'string') {
          return { url: item, title: options.title || '' };
        }
        return { url: item.url, title: item.title || options.title || '' };
      });
      loop = options.loop !== false;
      isOpen = true;
      currentIndex = 0;
      isPlaying = true;
      isMuted = false;

      video.muted = false;
      iconVolumeOn.classList.remove('hidden');
      iconVolumeMute.classList.add('hidden');

      const showCta = options.showCta !== false;
      if (showCta) {
        ctaContainer.classList.remove('hidden');
        ctaGradient.classList.remove('hidden');
        ctaLink.textContent = options.ctaText || defaultCtaText;
        ctaLink.setAttribute('href', options.ctaLink || defaultCtaLink);
      } else {
        ctaContainer.classList.add('hidden');
        ctaGradient.classList.add('hidden');
      }

      if (activeVideos.length > 1) {
        navBtnPrev?.classList.remove('hidden');
        navBtnNext?.classList.remove('hidden');
      } else {
        navBtnPrev?.classList.add('hidden');
        navBtnNext?.classList.add('hidden');
      }

      setupBars(activeVideos.length);

      modal.classList.remove('opacity-0', 'pointer-events-none');
      card.classList.remove('scale-95', 'translate-y-4', 'opacity-0');
      card.classList.add('scale-100', 'translate-y-0', 'opacity-100');

      document.body.style.overflow = 'hidden';

      loadVideo(0);
    };

    const closeModal = () => {
      isOpen = false;
      video.pause();

      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }

      modal.classList.add('opacity-0', 'pointer-events-none');
      card.classList.add('scale-95', 'translate-y-4', 'opacity-0');
      card.classList.remove('scale-100', 'translate-y-0', 'opacity-100');

      document.body.style.overflow = '';
    };

    window.openVideoStory = openVideoStory;
    window.closeVideoStory = closeModal;

    btnClose.addEventListener('click', closeModal);
    ctaLink?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === ' ' || e.code === 'Space') {
        e.preventDefault();
        togglePlay();
      }
      if (e.key === 'ArrowRight') handleNext();
      if (e.key === 'ArrowLeft') handlePrev();
    });

    zonePlay.addEventListener('click', togglePlay);
    zonePrev.addEventListener('click', (e) => {
      e.stopPropagation();
      handlePrev();
    });
    zoneNext.addEventListener('click', (e) => {
      e.stopPropagation();
      handleNext();
    });

    btnMute.addEventListener('click', () => {
      isMuted = !isMuted;
      video.muted = isMuted;
      if (isMuted) {
        iconVolumeOn.classList.add('hidden');
        iconVolumeMute.classList.remove('hidden');
      } else {
        iconVolumeOn.classList.remove('hidden');
        iconVolumeMute.classList.add('hidden');
      }
    });

    video.addEventListener('play', () => {
      if (!animationFrameId) {
        animationFrameId = requestAnimationFrame(updatePlayProgress);
      }
    });

    video.addEventListener('pause', () => {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
    });

    video.addEventListener('ended', handleNext);

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-video-story]');
      if (!trigger) return;

      e.preventDefault();
      const rawData = trigger.getAttribute('data-video-story');
      if (!rawData) return;

      try {
        let parsed = JSON.parse(rawData);
        if (Array.isArray(parsed)) {
          openVideoStory({ videos: parsed });
        } else if (typeof parsed === 'object') {
          openVideoStory(parsed);
        } else if (typeof parsed === 'string') {
          openVideoStory({ videos: [parsed] });
        }
      } catch (err) {
        openVideoStory({ videos: [rawData] });
      }
    });
  })();
</script>
